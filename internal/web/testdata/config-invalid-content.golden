<section class="config-invalid-alert" role="alert"><h2>This config fails to load</h2><code class="config-invalid-error">roles.implement.effort: invalid value &#34;ultra&#34;; want low, medium, high, or xhigh</code><p>syl ui only edits a config it can parse. Fix the file in your editor. This page picks up the change on its next refresh. Run history is unaffected.</p><div class="config-invalid-path"><code>/fixture/project/.syl/config.toml</code><button class="config-copy-path" type="button" data-copy-path="/fixture/project/.syl/config.toml">Copy path</button></div></section>
<section class="config-source-card" aria-label="Read-only config.toml"><div class="config-source-heading"><span>config.toml</span><span>read-only</span></div><div class="config-source"><div class="config-source-line"><span class="config-source-number">1</span><pre># Generated by syl init.</pre></div><div class="config-source-line"><span class="config-source-number">2</span><pre>[tracker]</pre></div><div class="config-source-line"><span class="config-source-number">3</span><pre>issues = &#34;github&#34;</pre></div><div class="config-source-line"><span class="config-source-number">4</span><pre>reviews = &#34;local&#34;</pre></div><div class="config-source-line"><span class="config-source-number">5</span><pre></pre></div><div class="config-source-line"><span class="config-source-number">6</span><pre>[roles.plan]</pre></div><div class="config-source-line"><span class="config-source-number">7</span><pre>harness = &#34;claude&#34;</pre></div><div class="config-source-line"><span class="config-source-number">8</span><pre>model = &#34;claude-opus-5&#34;</pre></div><div class="config-source-line"><span class="config-source-number">9</span><pre>effort = &#34;high&#34;</pre></div><div class="config-source-line"><span class="config-source-number">10</span><pre># mcp = true inherits user/project MCP configuration; false strips it for Claude.</pre></div><div class="config-source-line"><span class="config-source-number">11</span><pre># Codex ignores this field. Omitted defaults are true for plan and implement, and false for review.</pre></div><div class="config-source-line"><span class="config-source-number">12</span><pre>mcp = true</pre></div><div class="config-source-line"><span class="config-source-number">13</span><pre></pre></div><div class="config-source-line"><span class="config-source-number">14</span><pre>[roles.implement]</pre></div><div class="config-source-line"><span class="config-source-number">15</span><pre>harness = &#34;codex&#34;</pre></div><div class="config-source-line"><span class="config-source-number">16</span><pre>model = &#34;gpt-5.6-luna&#34;</pre></div><div class="config-source-line marked"><span class="config-source-number">17</span><pre>effort = &#34;ultra&#34;</pre></div><div class="config-source-line"><span class="config-source-number">18</span><pre># mcp = true inherits user/project MCP configuration; false strips it for Claude.</pre></div><div class="config-source-line"><span class="config-source-number">19</span><pre># Codex ignores this field. Omitted defaults are true for plan and implement, and false for review.</pre></div><div class="config-source-line"><span class="config-source-number">20</span><pre>mcp = true</pre></div><div class="config-source-line"><span class="config-source-number">21</span><pre></pre></div><div class="config-source-line"><span class="config-source-number">22</span><pre>[roles.review]</pre></div><div class="config-source-line"><span class="config-source-number">23</span><pre>harness = &#34;claude&#34;</pre></div><div class="config-source-line"><span class="config-source-number">24</span><pre>model = &#34;claude-sonnet-5&#34;</pre></div><div class="config-source-line"><span class="config-source-number">25</span><pre>effort = &#34;medium&#34;</pre></div><div class="config-source-line"><span class="config-source-number">26</span><pre># mcp = true inherits user/project MCP configuration; false strips it for Claude.</pre></div><div class="config-source-line"><span class="config-source-number">27</span><pre># Codex ignores this field. Omitted defaults are true for plan and implement, and false for review.</pre></div><div class="config-source-line"><span class="config-source-number">28</span><pre># Hooks that require MCP may cause one blocked-then-retried tool call in lean sessions.</pre></div><div class="config-source-line"><span class="config-source-number">29</span><pre>mcp = false</pre></div><div class="config-source-line"><span class="config-source-number">30</span><pre></pre></div><div class="config-source-line"><span class="config-source-number">31</span><pre>[loop]</pre></div><div class="config-source-line"><span class="config-source-number">32</span><pre>max_iterations = 3</pre></div><div class="config-source-line"><span class="config-source-number">33</span><pre></pre></div><div class="config-source-line"><span class="config-source-number">34</span><pre>[notifications]</pre></div><div class="config-source-line"><span class="config-source-number">35</span><pre>enabled = true</pre></div><div class="config-source-line"><span class="config-source-number">36</span><pre></pre></div><div class="config-source-line"><span class="config-source-number">37</span><pre>[worktree]</pre></div><div class="config-source-line"><span class="config-source-number">38</span><pre>root = &#34;~/.syl/worktrees&#34;</pre></div><div class="config-source-line"><span class="config-source-number">39</span><pre># A shell command used to provision dependencies in a fresh worktree.</pre></div><div class="config-source-line"><span class="config-source-number">40</span><pre># Example: setup = &#34;npm ci&#34;</pre></div><div class="config-source-line"><span class="config-source-number">41</span><pre>setup = &#34;&#34;</pre></div><div class="config-source-line"><span class="config-source-number">42</span><pre># Additional origin paths to copy into a fresh worktree.</pre></div><div class="config-source-line"><span class="config-source-number">43</span><pre># Example: copy = [&#34;.env&#34;, &#34;.env.local&#34;]</pre></div><div class="config-source-line"><span class="config-source-number">44</span><pre>copy = []</pre></div></div></section>


